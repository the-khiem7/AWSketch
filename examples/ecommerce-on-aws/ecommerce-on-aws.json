 "sections": [
  {
   "title": "The six flows",
   "open": true,
   "ordered": true,
   "items": [
    {
     "lead": "Customer web.",
     "text": "Customers and support staff resolve the domain in Route 53, pass CloudFront and WAF, and the load balancer sends requests to the ECS tasks."
    },
    {
     "lead": "Payments.",
     "text": "The payments gateway posts webhooks to SQS; a Lambda confirms each payment to the monolith, and a second Lambda calls the gateway back through the NAT gateway."
    },
    {
     "lead": "Shipping.",
     "text": "The shipping adapter Lambda reaches the carriers through the NAT gateway and the internet gateway."
    },
    {
     "lead": "Data and analytics.",
     "text": "The ECS tasks write to the Aurora writer, which syncs to the reader, feeds the data lake and Glue, Athena and QuickSight, and is backed up by AWS Backup."
    },
    {
     "lead": "AI assistant.",
     "text": "The assistant API calls the Bedrock agent, which looks up live data through a Lambda (DynamoDB and the reader) and policy text in the knowledge base on S3 vectors."
    },
    {
     "lead": "Delivery.",
     "text": "DevOps pushes code, GitHub Actions builds the images and pushes them to ECR."
    }
   ]
  }
 ]
